{
  "name": "mptool-root",
  "private": true,
  "description": "Miniapp is a lightweight framework for QQ/Wechat miniapp.",
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": "https://github.com/miniapp-tool/mptool",
  "type": "module",
  "scripts": {
    "build": "unrun scripts/sync-enhance.ts && cross-env NODE_ENV=production pnpm --stream -r run build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 2",
    "clean": "pnpm --stream -r run clean",
    "copy": "unrun scripts/copy-package.ts",
    "dev": "unrun scripts/sync-enhance.ts && cross-env NODE_ENV=production pnpm --stream -r run dev",
    "docs:build": "pnpm --dir=docs run docs:build",
    "docs:dev": "pnpm --dir=docs run docs:dev",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "packages:update": "pnpm dlx npm-check-updates -u --deep",
    "postinstall": "husky",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "2.0.1",
    "@lerna-lite/cli": "5.6.3",
    "@lerna-lite/publish": "5.6.3",
    "@mr-hope/tsconfig": "0.0.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "buffer": "6.0.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "miniprogram-api-typings": "5.2.3",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "vitest": "5.0.5"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "error"
    }
  }
}
